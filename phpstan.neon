parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - vendor
        - coverage (?)
        - .phpunit.cache (?)
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    scanDirectories:
        - vendor/php-stubs/wordpress-stubs
    # The WordPress test library is not installed during analysis, so these stubs stand in for
    # WP_UnitTestCase, tests_add_filter() and the ABSPATH and WP_PLUGIN_DIR constants.
    scanFiles:
        - tests/phpstan/wp-test-suite-stubs.php
    # Every ignore must match something, so a fixed problem cannot leave a stale pattern behind.
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # The e2e fixture requires this repository through WP_PLUGIN_DIR, because the Playground server
        # mounts the repository at wp-content/plugins/wp-settings-hub. That path does not exist where
        # the analysis runs.
        -
            identifier: requireOnce.fileNotFound
            path: tests/e2e/fixtures/settings-hub-e2e/settings-hub-e2e.php
            count: 1
