parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - vendor
        - coverage
        - .phpunit.cache
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    scanDirectories:
        - vendor/php-stubs/wordpress-stubs
    # The WordPress test library is not installed during analysis, so these stubs stand in for
    # WP_UnitTestCase, tests_add_filter() and the ABSPATH and WP_PLUGIN_DIR constants.
    scanFiles:
        - tests/phpstan/wp-test-suite-stubs.php
    # Every ignore must match something, so a fixed problem cannot leave a stale pattern behind.
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        - '#Right side of && is always true#'
        - '#does not accept non-empty-array#'
        - '#of function esc_html expects string#'
        - '#Cannot cast .* to string#'
        - '#Parameter .* expects string, .* given#'
        - '#Parameter .* expects callable#'
